+	                 scalerSourceCacheBuffer, (uint8_t*)&render.pal.rgb);
+	const std::string encoded_path = capture_last_screenshot_path;
+	CaptureState = previous_capture_state;
+	capturedir = previous_dir;
+	show_recorded_filename = previous_notification;
+	pathscr = previous_path;
+	if (encoded_path.empty() || rename(encoded_path.c_str(), filename.c_str()) != 0) {
+		if (!encoded_path.empty()) remove(encoded_path.c_str());
+		if (error) *error = "The PNG encoder could not write " + filename;
+		return false;
+	}
