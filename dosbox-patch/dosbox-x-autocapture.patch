+const char* CpuMode()
+{
+	if (!cpu.pmode) return "real";
+	return cpu.code.big ? "protected32" : "protected16";
+}
+
+void WriteSegmentState(std::ostringstream& json, const char* name, const SegNames seg)
+{
+	const uint16_t selector = SegValue(seg);
+	Descriptor descriptor;
+	const bool resolved = cpu.pmode && selector != 0 && cpu.gdt.GetDescriptor(selector, descriptor);
+	json << "    " << Escape(name) << ": {\"selector\": " << Escape(FormatHex(selector, 4))
+	     << ", \"base\": " << Escape(FormatHex(SegPhys(seg), 8));
+	if (!cpu.pmode) {
+		json << ", \"table\": null, \"descriptor_available\": false, \"limit\": "
+		     << Escape("0000FFFF") << "}";
+		return;
+	}
+	if (!resolved) {
+		json << ", \"table\": " << Escape((selector & 4) ? "ldt" : "gdt")
+		     << ", \"descriptor_index\": " << (selector >> 3u)
+		     << ", \"descriptor_available\": false, \"limit\": null}";
+		return;
+	}
+	json << ", \"table\": " << Escape((selector & 4) ? "ldt" : "gdt")
+	     << ", \"descriptor_index\": " << (selector >> 3u)
+	     << ", \"descriptor_available\": true"
+	     << ", \"limit\": " << Escape(FormatHex(descriptor.GetLimit(), 8))
+	     << ", \"access_type\": " << Escape(FormatHex(descriptor.Type(), 2))
+	     << ", \"dpl\": " << descriptor.DPL()
+	     << ", \"present\": " << (descriptor.saved.seg.p ? "true" : "false")
+	     << ", \"default_32bit\": " << (descriptor.Big() ? "true" : "false")
+	     << ", \"granularity\": " << (descriptor.saved.seg.g ? "true" : "false") << "}";
+}
+
+struct MachineCaptureState {
+	Bitu cr0 = 0;
+	bool pmode = false;
+	Bitu cpl = 0;
+	LinearPt gdtr_base = 0;
+	Bitu gdtr_limit = 0;
+	LinearPt idtr_base = 0;
+	Bitu idtr_limit = 0;
+	uint16_t selectors[6] = {};
+	PhysPt bases[6] = {};
+};
+
+MachineCaptureState ReadMachineCaptureState()
+{
+	MachineCaptureState snapshot;
+	snapshot.cr0 = cpu.cr0;
+	snapshot.pmode = cpu.pmode;
+	snapshot.cpl = cpu.cpl;
+	snapshot.gdtr_base = cpu.gdt.GetBase();
+	snapshot.gdtr_limit = cpu.gdt.GetLimit();
+	snapshot.idtr_base = cpu.idt.GetBase();
+	snapshot.idtr_limit = cpu.idt.GetLimit();
+	const SegNames segments[] = {cs, ds, es, ss, fs, gs};
+	for (size_t i = 0; i < sizeof(segments) / sizeof(segments[0]); ++i) {
+		snapshot.selectors[i] = SegValue(segments[i]);
+		snapshot.bases[i] = SegPhys(segments[i]);
+	}
+	return snapshot;
+}
+
+bool MachineCaptureStateMatches(const MachineCaptureState& before)
+{
+	if (cpu.cr0 != before.cr0 || cpu.pmode != before.pmode || cpu.cpl != before.cpl ||
+	    cpu.gdt.GetBase() != before.gdtr_base || cpu.gdt.GetLimit() != before.gdtr_limit ||
+	    cpu.idt.GetBase() != before.idtr_base || cpu.idt.GetLimit() != before.idtr_limit)
+		return false;
+	const SegNames segments[] = {cs, ds, es, ss, fs, gs};
+	for (size_t i = 0; i < sizeof(segments) / sizeof(segments[0]); ++i) {
+		if (SegValue(segments[i]) != before.selectors[i] || SegPhys(segments[i]) != before.bases[i])
+			return false;
+	}
+	return true;
+}
+
+bool WriteMachineState(const std::string& path, std::string* error)
+{
+	const MachineCaptureState before = ReadMachineCaptureState();
+	std::ostringstream json;
+	json << "{\n  \"cpu_mode\": " << Escape(CpuMode())
+	     << ",\n  \"cpl\": " << (cpu.pmode ? std::to_string(cpu.cpl) : "null")
+	     << ",\n  \"cr0\": " << Escape(FormatHex(cpu.cr0, 8))
+	     << ",\n  \"gdtr\": {\"base\": " << Escape(FormatHex(cpu.gdt.GetBase(), 8))
+	     << ", \"limit\": " << Escape(FormatHex(cpu.gdt.GetLimit(), 4)) << "}"
+	     << ",\n  \"idtr\": {\"base\": " << Escape(FormatHex(cpu.idt.GetBase(), 8))
+	     << ", \"limit\": " << Escape(FormatHex(cpu.idt.GetLimit(), 4)) << "}"
+	     << ",\n  \"segments\": {\n";
+	WriteSegmentState(json, "cs", cs); json << ",\n";
+	WriteSegmentState(json, "ds", ds); json << ",\n";
+	WriteSegmentState(json, "es", es); json << ",\n";
+	WriteSegmentState(json, "ss", ss); json << ",\n";
+	WriteSegmentState(json, "fs", fs); json << ",\n";
+	WriteSegmentState(json, "gs", gs); json << "\n  }\n}\n";
+	if (!MachineCaptureStateMatches(before)) {
+		if (error) *error = "CPU state changed while serializing machine state";
+		return false;
+	}
+	return WriteText(path, json.str(), error);
+}
+
+struct DacCaptureState {
+	uint8_t bits = 0;
+	uint8_t pel_mask = 0;
+	uint8_t pel_index = 0;
+	uint8_t component_state = 0;
+	uint8_t write_index = 0;
+	uint8_t read_index = 0;
+	RGBEntry palette[256] = {};
+};
+
+DacCaptureState ReadDacCaptureState()
+{
+	DacCaptureState snapshot;
+	snapshot.bits = vga.dac.bits;
+	snapshot.pel_mask = vga.dac.pel_mask;
+	snapshot.pel_index = vga.dac.pel_index;
+	snapshot.component_state = vga.dac.state;
+	snapshot.write_index = vga.dac.write_index;
+	snapshot.read_index = vga.dac.read_index;
+	std::memcpy(snapshot.palette, vga.dac.rgb, sizeof(snapshot.palette));
+	return snapshot;
+}
+
+bool DacCaptureStateMatches(const DacCaptureState& before)
+{
+	return vga.dac.bits == before.bits && vga.dac.pel_mask == before.pel_mask &&
+	       vga.dac.pel_index == before.pel_index && vga.dac.state == before.component_state &&
+	       vga.dac.write_index == before.write_index && vga.dac.read_index == before.read_index &&
+	       std::memcmp(vga.dac.rgb, before.palette, sizeof(before.palette)) == 0;
+}
+
+bool WriteVgaState(const std::string& path, std::string* error)
+{
+	const DacCaptureState dac_before = ReadDacCaptureState();
+	RenderScreenshotGeometry screenshot_geometry;
+	const bool renderer_geometry_available = RENDER_GetCurrentFrameScreenshotGeometry(&screenshot_geometry);
+	std::ostringstream json;
+	json << "{\n  \"guest_vga\": {\"mode\": " << Escape(mode_texts[vga.mode])
+	     << ", \"mode_id\": " << static_cast<unsigned int>(vga.mode)
+	     << ", \"width\": " << vga.draw.width << ", \"height\": " << vga.draw.height
+	     << ", \"bpp\": " << vga.draw.bpp << ", \"pitch\": " << vga.draw.line_length
+	     << ", \"display_address\": " << Escape(FormatHex(vga.draw.address, 8))
+	     << ", \"address_add\": " << vga.draw.address_add
+	     << ", \"video_memory_bytes\": " << vga.mem.memsize
+         << ", \"configured_display_start\": " << vga.config.display_start
+         << ", \"real_start\": " << vga.config.real_start
+         << ", \"pel_panning\": " << unsigned(vga.config.pel_panning)
+         << ", \"hlines_skip\": " << unsigned(vga.config.hlines_skip)
+         << ", \"bytes_skip\": " << unsigned(vga.config.bytes_skip)
+         << ", \"addr_shift\": " << unsigned(vga.config.addr_shift)
+         << ", \"chained\": " << (vga.config.chained ? "true" : "false")
+         << ", \"compatible_chain4\": " << (vga.config.compatible_chain4 ? "true" : "false")
+	     << ", \"linear_framebuffer\": {\"mapped\": " << (vga.lfb.handler ? "true" : "false")
+	     << ", \"page\": " << vga.lfb.page << ", \"address\": " << Escape(FormatHex(vga.lfb.addr, 8))
+	     << ", \"mask\": " << Escape(FormatHex(vga.lfb.mask, 8)) << "}},\n";
+	if (renderer_geometry_available) {
+		json << "  \"renderer_source\": {\"width\": " << screenshot_geometry.source_width
+		     << ", \"height\": " << screenshot_geometry.source_height
+		     << ", \"bpp\": " << screenshot_geometry.source_bpp
+		     << ", \"double_width\": " << (screenshot_geometry.double_width ? "true" : "false")
+		     << ", \"double_height\": " << (screenshot_geometry.double_height ? "true" : "false") << "},\n"
+		     << "  \"renderer_output\": {\"width\": " << screenshot_geometry.output_width
+		     << ", \"height\": " << screenshot_geometry.output_height
+		     << ", \"bpp\": " << screenshot_geometry.source_bpp << "}";
+	} else {
+		json << "  \"renderer_source\": {\"available\": false},\n"
+		     << "  \"renderer_output\": {\"available\": false}";
+	}
+	if (config.vga_include_palette) {
+		json << ",\n  \"palette_format\": " << Escape(vga.dac.bits == 8 ? "vga8" : "vga6")
+		     << ",\n  \"dac\": {\"read_index\": " << static_cast<unsigned int>(vga.dac.read_index)
+		     << ", \"write_index\": " << static_cast<unsigned int>(vga.dac.write_index)
+		     << ", \"component_state\": " << static_cast<unsigned int>(vga.dac.state)
+		     << ", \"pel_index\": " << static_cast<unsigned int>(vga.dac.pel_index)
+		     << ", \"pel_mask\": " << static_cast<unsigned int>(vga.dac.pel_mask) << "}"
+		     << ",\n  \"palette\": [";
+		for (unsigned int i = 0; i < 256; ++i) {
+			const RGBEntry& rgb = vga.dac.rgb[i];
+			json << "[" << static_cast<unsigned int>(rgb.red) << ", " << static_cast<unsigned int>(rgb.green)
+			     << ", " << static_cast<unsigned int>(rgb.blue) << "]" << (i == 255 ? "" : ",");
+		}
+		json << "]";
+	}
+	if (config.vga_include_registers) {
+		json << ",\n  \"registers\": {\"misc_output\": " << static_cast<unsigned int>(vga.misc_output)
+		     << ", \"sequencer\": {\"index\": " << static_cast<unsigned int>(vga.seq.index)
+		     << ", \"reset\": " << static_cast<unsigned int>(vga.seq.reset)
+		     << ", \"clocking_mode\": " << static_cast<unsigned int>(vga.seq.clocking_mode)
+		     << ", \"map_mask\": " << static_cast<unsigned int>(vga.seq.map_mask)
+		     << ", \"character_map_select\": " << static_cast<unsigned int>(vga.seq.character_map_select)
+		     << ", \"memory_mode\": " << static_cast<unsigned int>(vga.seq.memory_mode) << "}"
+		     << ", \"crtc\": {\"index\": " << static_cast<unsigned int>(vga.crtc.index)
+		     << ", \"horizontal_total\": " << static_cast<unsigned int>(vga.crtc.horizontal_total)
+		     << ", \"horizontal_display_end\": " << static_cast<unsigned int>(vga.crtc.horizontal_display_end)
+             << ", \"start_horizontal_blanking\": " << unsigned(vga.crtc.start_horizontal_blanking)
+             << ", \"end_horizontal_blanking\": " << unsigned(vga.crtc.end_horizontal_blanking)
+             << ", \"start_horizontal_retrace\": " << unsigned(vga.crtc.start_horizontal_retrace)
+             << ", \"end_horizontal_retrace\": " << unsigned(vga.crtc.end_horizontal_retrace)
+             << ", \"overflow\": " << unsigned(vga.crtc.overflow)
+             << ", \"preset_row_scan\": " << unsigned(vga.crtc.preset_row_scan)
+             << ", \"maximum_scan_line\": " << unsigned(vga.crtc.maximum_scan_line)
+             << ", \"cursor_start\": " << unsigned(vga.crtc.cursor_start)
+             << ", \"cursor_end\": " << unsigned(vga.crtc.cursor_end)
+             << ", \"start_address_high\": " << unsigned(vga.crtc.start_address_high)
+             << ", \"start_address_low\": " << unsigned(vga.crtc.start_address_low)
+             << ", \"cursor_location_high\": " << unsigned(vga.crtc.cursor_location_high)
+             << ", \"cursor_location_low\": " << unsigned(vga.crtc.cursor_location_low)
+             << ", \"vertical_retrace_start\": " << unsigned(vga.crtc.vertical_retrace_start)
+             << ", \"vertical_retrace_end\": " << unsigned(vga.crtc.vertical_retrace_end)
+             << ", \"start_vertical_blanking\": " << unsigned(vga.crtc.start_vertical_blanking)
+             << ", \"end_vertical_blanking\": " << unsigned(vga.crtc.end_vertical_blanking)
+             << ", \"underline_location\": " << unsigned(vga.crtc.underline_location)
+             << ", \"line_compare\": " << unsigned(vga.crtc.line_compare)
+             << ", \"read_only\": " << (vga.crtc.read_only ? "true" : "false")
+		     << ", \"vertical_total\": " << static_cast<unsigned int>(vga.crtc.vertical_total)
+		     << ", \"vertical_display_end\": " << static_cast<unsigned int>(vga.crtc.vertical_display_end)
+		     << ", \"offset\": " << static_cast<unsigned int>(vga.crtc.offset)
+		     << ", \"mode_control\": " << static_cast<unsigned int>(vga.crtc.mode_control) << "}"
+		     << ", \"graphics_controller\": {\"index\": " << static_cast<unsigned int>(vga.gfx.index)
+		     << ", \"set_reset\": " << static_cast<unsigned int>(vga.gfx.set_reset)
+		     << ", \"enable_set_reset\": " << static_cast<unsigned int>(vga.gfx.enable_set_reset)
+		     << ", \"mode\": " << static_cast<unsigned int>(vga.gfx.mode)
+		     << ", \"miscellaneous\": " << static_cast<unsigned int>(vga.gfx.miscellaneous)
+		     << ", \"bit_mask\": " << static_cast<unsigned int>(vga.gfx.bit_mask) << "}"
+		     << ", \"attribute_controller\": {\"index\": " << static_cast<unsigned int>(vga.attr.index)
+		     << ", \"mode_control\": " << static_cast<unsigned int>(vga.attr.mode_control)
+		     << ", \"color_plane_enable\": " << static_cast<unsigned int>(vga.attr.color_plane_enable)
+			 << ", \"color_select\": " << static_cast<unsigned int>(vga.attr.color_select) << "}}";
+	}
+	json << "\n}\n";
+	if (!DacCaptureStateMatches(dac_before)) {
+		if (error) *error = "VGA DAC state changed while serializing VGA state";
+		return false;
+	}
+	return WriteText(path, json.str(), error);
+}
+
+bool WriteFramebuffer(const std::string& path, std::string* error)
+{
+	if (!vga.mem.linear || !vga.mem.memsize) {
+		if (error) *error = "VGA video memory is not available";
+		return false;
+	}
+	FILE* file = fopen(path.c_str(), "wb");
+	if (!file) {
+		if (error) *error = "Unable to open " + path;
+		return false;
+	}
+	const bool written = fwrite(vga.mem.linear, 1, vga.mem.memsize, file) == vga.mem.memsize;
+	const bool flushed = fflush(file) == 0;
+	const bool closed = fclose(file) == 0;
+	if ((!written || !flushed || !closed) && error) *error = "Unable to write " + path;
+	return written && flushed && closed;
+}
+
+struct Asset {
+	std::string name;
+	std::string file;
+	std::string status;
+	std::string error;
+	uint64_t size = 0;
+	uint64_t expected_size = 0;
+	bool has_address = false;
+	uint16_t segment = 0;
+	uint32_t offset = 0;
+	uint64_t every_n_captures = 1;
+	std::string reason;
+	std::string metadata;
+};
+
+void RecordFinalizedAssetSize(const std::string& path, Asset* asset)
+{
+	struct stat info;
+	if (stat(path.c_str(), &info) == 0) {
+		asset->size = static_cast<uint64_t>(info.st_size);
+		return;
+	}
+	if (asset->status == "ok" || asset->status == "complete") {
+		asset->status = "error";
+		asset->error = "Unable to determine finalized file size";
+	}
+}
+
+bool ReadPngGeometry(const std::string& path, uint32_t* width, uint32_t* height)
+{
+	uint8_t header[24] = {};
+	FILE* file = fopen(path.c_str(), "rb");
+	if (!file) return false;
+	const bool read = fread(header, 1, sizeof(header), file) == sizeof(header);
+	const bool closed = fclose(file) == 0;
+	if (!read || !closed || std::memcmp(header, "\x89PNG\r\n\x1a\n", 8) != 0 ||
+	    std::memcmp(header + 12, "IHDR", 4) != 0) return false;
+	*width = (static_cast<uint32_t>(header[16]) << 24u) | (static_cast<uint32_t>(header[17]) << 16u) |
+	         (static_cast<uint32_t>(header[18]) << 8u) | static_cast<uint32_t>(header[19]);
+	*height = (static_cast<uint32_t>(header[20]) << 24u) | (static_cast<uint32_t>(header[21]) << 16u) |
+	          (static_cast<uint32_t>(header[22]) << 8u) | static_cast<uint32_t>(header[23]);
+	return *width != 0 && *height != 0;
+}
+
+std::string ScreenshotGeometryMetadata(const RenderScreenshotGeometry& geometry,
+				       const uint32_t png_width, const uint32_t png_height)
+{
+	std::ostringstream json;
+	json << "{\"source_width\": " << geometry.source_width
+	     << ", \"source_height\": " << geometry.source_height
+	     << ", \"output_width\": " << png_width
+	     << ", \"output_height\": " << png_height
+	     << ", \"double_width\": " << (geometry.double_width ? "true" : "false")
+	     << ", \"double_height\": " << (geometry.double_height ? "true" : "false") << "}";
+	return json.str();
+}
+
+std::string X87StateJson()
+{
+    std::ostringstream out;
+#if C_FPU
+    out << "{\"available\":true,\"internal_backend_image_not_forced_guest_save\":true"
+        << ",\"architecture\":" << unsigned(FPU_ArchitectureType)
+        << ",\"cw\":" << fpu.cw.reg << ",\"sw\":" << fpu.sw.reg
+        << ",\"top\":" << unsigned(fpu.sw.top) << ",\"physical_slots\":[";
+    for (unsigned int i = 0; i < 9; ++i) {
+        if (i) out << ',';
+        out << "{\"slot\":" << i << ",\"tag\":" << unsigned(fpu.tags[i])
+            << ",\"backing80_hex\":" << Escape(FormatHex(fpu.regs_80[i].raw.h, 4) + FormatHex(fpu.regs_80[i].raw.l, 16));
+#if defined(HAS_LONG_DOUBLE) || C_FPU_X86
+        out << ",\"authoritative_encoding\":\"extended80\"";
+#else
+        out << ",\"binary64_hex\":" << Escape(FormatHex(uint64_t(fpu.regs[i].ll), 16))
+            << ",\"use80\":" << (fpu.use80[i] ? "true" : "false")
+            << ",\"authoritative_encoding\":" << Escape(fpu.use80[i] ? "extended80" : "binary64");
+#endif
+        out << '}';
+    }
+    out << "],\"mxcsr\":" << fpu.mxcsr << ",\"instruction_data_pointers_available\":false}";
+#else
+    out << "{\"available\":false,\"reason\":\"C_FPU disabled\"}";
+#endif
+    return out.str();
+}
+
+std::string EventContext()
+{
+    std::ostringstream out;
+    out << "\"sequence\":" << event_sequence++ << ",\"normal_boundary\":" << instruction_boundary_count
+        << ",\"time_ms\":" << std::setprecision(std::numeric_limits<pic_tickindex_t>::max_digits10) << PIC_FullIndex()
+        << ",\"cs\":" << Escape(FormatHex(SegValue(cs), 4)) << ",\"eip\":" << Escape(FormatHex(reg_eip, 8))
+        << ",\"ss\":" << Escape(FormatHex(SegValue(ss), 4)) << ",\"esp\":" << Escape(FormatHex(reg_esp, 8));
+    return out.str();
+}
