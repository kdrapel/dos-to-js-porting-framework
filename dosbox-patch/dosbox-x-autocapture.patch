+
+std::string Join(const std::string& left, const std::string& right)
+{
+	if (left.empty()) return right;
+	const char tail = left[left.size() - 1];
+	if (tail == '/' || tail == '\\') return left + right;
+#ifdef WIN32
+	return left + "\\" + right;
+#else
+	return left + "/" + right;
+#endif
+}
+
+bool IsDirectory(const std::string& path)
+{
+	struct stat info;
+	return stat(path.c_str(), &info) == 0 && (info.st_mode & S_IFDIR) != 0;
+}
+
+bool MakeDirectory(const std::string& path)
+{
+	if (path.empty() || IsDirectory(path)) return true;
+#ifdef WIN32
+	if (_mkdir(path.c_str()) == 0) return true;
+#else
+	if (mkdir(path.c_str(), 0700) == 0) return true;
+#endif
+	return errno == EEXIST && IsDirectory(path);
+}
+
+bool MakeDirectories(const std::string& path)
+{
+	if (path.empty()) return false;
+	std::string current;
+	std::string::size_type index = 0;
+#ifdef WIN32
+	if (path.size() > 2 && path[1] == ':') {
+		current = path.substr(0, 2);
+		index = 2;
+	}
+#endif
+	if (path[0] == '/' || path[0] == '\\') {
+		current.assign(1, path[0]);
+		index = 1;
+	}
+	while (index < path.size()) {
+		const std::string::size_type end = path.find_first_of("/\\", index);
+		const std::string part = path.substr(index, end == std::string::npos ? end : end - index);
+		if (!part.empty()) {
+			current = current.empty() ? part : Join(current, part);
+			if (!MakeDirectory(current)) return false;
+		}
+		if (end == std::string::npos) break;
+		index = end + 1;
+	}
+	return IsDirectory(path);
+}
+
+bool WriteText(const std::string& path, const std::string& text, std::string* error)
+{
+	FILE* file = fopen(path.c_str(), "wb");
+	if (!file) {
+		if (error) *error = "Unable to open " + path;
+		return false;
+	}
+	const size_t written = fwrite(text.data(), 1, text.size(), file);
+	const bool flushed = fflush(file) == 0;
+	const bool closed = fclose(file) == 0;
+	const bool ok = written == text.size() && flushed && closed;
+	if (!ok && error) *error = "Unable to write " + path;
+	return ok;
+}
+
+bool WriteNewText(const std::string& path, const std::string& contents, bool* exists)
+{
+	*exists = false;
+#ifdef WIN32
+	HANDLE file = CreateFileA(path.c_str(), GENERIC_WRITE, 0, NULL, CREATE_NEW,
+	                          FILE_ATTRIBUTE_NORMAL, NULL);
+	if (file == INVALID_HANDLE_VALUE) {
+		const DWORD reason = GetLastError();
+		*exists = reason == ERROR_FILE_EXISTS || reason == ERROR_ALREADY_EXISTS;
+		return false;
+	}
+	DWORD written = 0;
+	const bool ok = WriteFile(file, contents.data(), static_cast<DWORD>(contents.size()),
+	                          &written, NULL) != 0 && written == contents.size() &&
+	                FlushFileBuffers(file) != 0;
+	const bool closed = CloseHandle(file) != 0;
+	if (!ok || !closed) DeleteFileA(path.c_str());
+	return ok && closed;
+#else
+	const int descriptor = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0600);
+	if (descriptor < 0) {
+		*exists = errno == EEXIST;
+		return false;
+	}
+	FILE* file = fdopen(descriptor, "wb");
+	if (!file) {
+		close(descriptor);
+		remove(path.c_str());
+		return false;
+	}
+	const bool written = fwrite(contents.data(), 1, contents.size(), file) == contents.size();
+	const bool flushed = fflush(file) == 0;
+	const bool closed = fclose(file) == 0;
+	if (!written || !flushed || !closed) remove(path.c_str());
+	return written && flushed && closed;
+#endif
+}
+
+bool WriteAtomic(const std::string& path, const std::string& text, std::string* error)
+{
+	const std::string temporary = path + ".tmp";
+	if (!WriteText(temporary, text, error)) return false;
+#ifdef WIN32
+	const bool renamed = MoveFileExA(temporary.c_str(), path.c_str(),
+	                                 MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+	const bool renamed = rename(temporary.c_str(), path.c_str()) == 0;
+#endif
+	if (!renamed) {
+		if (error) *error = "Unable to finalize " + path;
+		return false;
+	}
+	return true;
+}
+
+std::string Escape(const std::string& value)
+{
+	JsonValue string = JsonValue::String(value);
+	return dosbox_agent::AGENT_SerializeJson(string);
+}
+
+bool ReadFile(const std::string& path, std::string* contents, std::string* error)
+{
+	std::ifstream file(path.c_str(), std::ios::binary);
+	if (!file) {
+		if (error) *error = "Unable to read configuration: " + path;
+		return false;
+	}
+	std::ostringstream data;
+	data << file.rdbuf();
+	if (!file.good() && !file.eof()) {
+		if (error) *error = "Failed while reading configuration: " + path;
+		return false;
+	}
+	*contents = data.str();
+	return true;
+}
+
+bool GetObject(const JsonValue& value, const char* name, const JsonValue** result,
+		       const std::string& path, std::string* error)
+{
+	*result = value.Find(name);
+	if (!*result || (*result)->type != JsonType::Object) {
+		if (error) *error = path + "." + name + " must be an object";
+		return false;
+	}
+	return true;
+}
+
+bool GetString(const JsonValue& value, const char* name, std::string* result,
+		       const std::string& path, std::string* error)
+{
+	const JsonValue* field = value.Find(name);
+	if (!field || field->type != JsonType::String) {
+		if (error) *error = path + "." + name + " must be a string";
+		return false;
+	}
+	*result = field->text;
+	return true;
+}
+
+bool GetBool(const JsonValue& value, const char* name, const bool fallback,
+		     bool* result, const std::string& path, std::string* error)
+{
+	const JsonValue* field = value.Find(name);
+	if (!field) { *result = fallback; return true; }
+	if (field->type != JsonType::Bool) {
+		if (error) *error = path + "." + name + " must be a boolean";
+		return false;
+	}
+	*result = field->boolean;
+	return true;
+}
+
+bool GetUnsigned(const JsonValue& value, const char* name, const uint64_t fallback,
+			 bool required, uint64_t* result, const std::string& path, std::string* error)
+{
+	const JsonValue* field = value.Find(name);
+	if (!field) {
+		if (!required) { *result = fallback; return true; }
+		if (error) *error = path + "." + name + " is required";
+		return false;
+	}
+	if (field->type != JsonType::Number || field->text.empty() || field->text[0] == '-') {
+		if (error) *error = path + "." + name + " must be a non-negative integer";
+		return false;
+	}
+	char* end = NULL;
+	errno = 0;
+	const unsigned long long number = strtoull(field->text.c_str(), &end, 10);
+	if (errno || end == field->text.c_str() || *end || number > (std::numeric_limits<uint64_t>::max)()) {
+		if (error) *error = path + "." + name + " is outside the supported integer range";
+		return false;
+	}
+	*result = static_cast<uint64_t>(number);
+	return true;
+}
+
+bool ParseFormatHex(const JsonValue& value, const char* name, const uint64_t maximum,
+		  uint64_t* result, const std::string& path, std::string* error)
+{
+	const JsonValue* field = value.Find(name);
+	if (!field || field->type != JsonType::String || field->text.empty()) {
+		if (error) *error = path + "." + name + " must be a non-empty hexadecimal string";
+		return false;
+	}
+	const std::string& text = field->text;
+	if (text.size() > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) {
+		if (error) *error = path + "." + name + " must not include a 0x prefix";
+		return false;
+	}
+	for (std::string::const_iterator it = text.begin(); it != text.end(); ++it) {
+		if (!std::isxdigit(static_cast<unsigned char>(*it))) {
+			if (error) *error = path + "." + name + " must contain hexadecimal digits only";
+			return false;
+		}
+	}
+	char* end = NULL;
+	errno = 0;
+	const unsigned long long number = strtoull(text.c_str(), &end, 16);
+	if (errno || !end || *end || number > maximum) {
+		if (error) *error = path + "." + name + " is outside the supported range";
+		return false;
+	}
+	*result = static_cast<uint64_t>(number);
+	return true;
+}
+
+bool SafeName(const std::string& name)
+{
+	if (name.empty() || name == "." || name == "..") return false;
+	for (std::string::const_iterator it = name.begin(); it != name.end(); ++it) {
+		const unsigned char c = static_cast<unsigned char>(*it);
+		if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+	      (c >= '0' && c <= '9') || c == '_' || c == '-')) return false;
+	}
+	return true;
+}
+
+bool ParseCadence(const JsonValue& value, const std::string& path, uint64_t* cadence,
+			  std::string* error)
+{
+	uint64_t parsed = 1;
+	if (!GetUnsigned(value, "every_n_captures", 1, false, &parsed, path, error)) return false;
+	if (parsed == 0) {
+		if (error) *error = path + ".every_n_captures must be at least 1";
+		return false;
+	}
+	*cadence = parsed;
+	return true;
+}
+
+bool ParseAsset(const JsonValue& object, const char* name, AssetConfiguration* asset,
+			const std::string& path, std::string* error)
+{
+	const JsonValue* value = object.Find(name);
+	if (!value) return true;
+	if (value->type != JsonType::Object ||
+	    !GetBool(*value, "enabled", false, &asset->enabled, path + "." + name, error) ||
+	    !ParseCadence(*value, path + "." + name, &asset->every_n_captures, error)) return false;
+	return true;
+}
+
+bool IsDue(const uint64_t capture, const uint64_t cadence)
+{
+	return cadence != 0 && capture % cadence == 0;
+}
+
+bool ParseConfiguration(const std::string& path, Configuration* parsed, std::string* error)
+{
+	std::string text;
+	if (!ReadFile(path, &text, error)) return false;
+	JsonValue root;
+	if (!dosbox_agent::AGENT_ParseJson(text, &root, error)) return false;
+	if (root.type != JsonType::Object) {
+		if (error) *error = "configuration root must be an object";
+		return false;
+	}
+	uint64_t version = 0;
+	if (!GetUnsigned(root, "version", 0, true, &version, "configuration", error) ||
+	    (version != 1 && version != 2)) {
+		if (error && error->empty()) *error = "configuration.version must equal 1 or 2";
+		return false;
+	}
+	Configuration result;
+	result.version = version;
+	const JsonValue* output = NULL;
+	if (version == 2 && !root.Find("output")) {
+		if (!GetString(root, "output_directory", &result.output_directory, "configuration", error)) return false;
+	} else if (!GetObject(root, "output", &output, "configuration", error) ||
+	           !GetString(*output, "directory", &result.output_directory, "configuration.output", error)) return false;
+	if (result.output_directory.empty()) {
+		if (error) *error = "configuration.output.directory must not be empty";
+		return false;
+	}
+	const JsonValue* trigger = NULL;
+	if (!GetObject(root, "trigger", &trigger, "configuration", error)) return false;
+	std::string trigger_type;
+	if (!GetString(*trigger, "type", &trigger_type, "configuration.trigger", error)) return false;
+	if (trigger_type != "emulated_time") {
+		if (error) *error = "configuration.trigger.type must be emulated_time";
+		return false;
+	}
+	uint64_t interval_ms = 0, delay_ms = 1000;
+	if (!GetUnsigned(*trigger, "interval_ms", 0, true, &interval_ms, "configuration.trigger", error) ||
+	    !GetUnsigned(*trigger, "initial_delay_ms", 1000, false, &delay_ms, "configuration.trigger", error)) return false;
+	if (interval_ms == 0 || interval_ms > (std::numeric_limits<uint64_t>::max)() / 1000 ||
+	    delay_ms > (std::numeric_limits<uint64_t>::max)() / 1000) {
+		if (error) *error = "trigger intervals must be positive and fit in microseconds";
+		return false;
+	}
+	result.interval_us = interval_ms * 1000;
+	result.initial_delay_us = delay_ms * 1000;
+	const JsonValue* process = root.Find("process");
+	if (process) {
+		if (process->type != JsonType::Object) {
+			if (error) *error = "configuration.process must be an object";
+			return false;
+		}
+		std::string mode;
+		if (process->Find("mode") && (!GetString(*process, "mode", &mode, "configuration.process", error) || mode != "current_or_next")) {
+			if (error && error->empty()) *error = "configuration.process.mode must be current_or_next";
+			return false;
+		}
+		std::string on_exit;
+		if (process->Find("on_exit") && (!GetString(*process, "on_exit", &on_exit, "configuration.process", error) || on_exit != "stop")) {
+			if (error && error->empty()) *error = "configuration.process.on_exit must be stop";
+			return false;
+		}
+	}
+	const char* capture_name = version == 1 ? "capture" : "assets";
+	const JsonValue* capture = root.Find(capture_name);
+	if (!capture && version == 2) { // Accept the v1 nesting in a v2 file for painless migration.
+		capture_name = "capture";
+		capture = root.Find(capture_name);
+	}
+	if (!capture || capture->type != JsonType::Object) {
+		if (error) *error = std::string("configuration.") + capture_name + " must be an object";
+		return false;
+	}
+	const std::string capture_path = std::string("configuration.") + capture_name;
+	const JsonValue* screenshot = capture->Find("screenshot");
+	if (screenshot) {
+		if (screenshot->type != JsonType::Object || !GetBool(*screenshot, "enabled", true, &result.screenshot, capture_path + ".screenshot", error) ||
+		    !ParseCadence(*screenshot, capture_path + ".screenshot", &result.screenshot_every_n_captures, error)) return false;
+		std::string format;
+		if (screenshot->Find("format") && (!GetString(*screenshot, "format", &format, capture_path + ".screenshot", error) || format != "png")) {
+			if (error && error->empty()) *error = "configuration.capture.screenshot.format must be png";
+			return false;
+		}
+	}
+	const JsonValue* registers = capture->Find("registers");
+	if (registers) {
+		if (registers->type != JsonType::Object || !GetBool(*registers, "enabled", true, &result.registers, capture_path + ".registers", error) ||
+		    !ParseCadence(*registers, capture_path + ".registers", &result.registers_every_n_captures, error)) return false;
+		std::string format;
+		if (registers->Find("format") && (!GetString(*registers, "format", &format, capture_path + ".registers", error) || format != "json")) {
+			if (error && error->empty()) *error = "configuration.capture.registers.format must be json";
+			return false;
+		}
+	}
+	if (version == 2) {
+		if (!ParseAsset(*capture, "machine_state", &result.machine_state, capture_path, error) ||
+		    !ParseAsset(*capture, "vga_state", &result.vga_state, capture_path, error) ||
+		    !ParseAsset(*capture, "framebuffer", &result.framebuffer, capture_path, error) ||
+            !ParseAsset(*capture, "device_state", &result.device_state, capture_path, error) ||
+            !ParseAsset(*capture, "x87_state", &result.x87_state, capture_path, error) ||
+            !ParseAsset(*capture, "render_surface", &result.render_surface, capture_path, error)) return false;
+        const JsonValue* reference = root.Find("reference");
+        if (reference) {
+            if (reference->type != JsonType::Object ||
+                !GetBool(*reference, "enabled", false, &result.reference_enabled, "configuration.reference", error) ||
+                !GetBool(*reference, "trace_instructions", false, &result.trace_instructions, "configuration.reference", error) ||
+                !GetBool(*reference, "start_at_first_address", false, &result.start_at_first_address, "configuration.reference", error) ||
+                !GetUnsigned(*reference, "expected_cycles", 0, false, &result.expected_cycles, "configuration.reference", error) ||
+                !GetUnsigned(*reference, "max_events", 100000, false, &result.max_events, "configuration.reference", error)) return false;
+            if (result.expected_cycles > uint64_t((std::numeric_limits<cpu_cycles_count_t>::max)())) {
+                if (error) *error = "configuration.reference.expected_cycles exceeds the supported cycle count";
+                return false;
+            }
+            if (result.max_events == 0 || result.max_events > 1000000) {
+                if (error) *error = "configuration.reference.max_events must be 1..1000000";
+                return false;
+            }
+        }
+		const JsonValue* vga_state = capture->Find("vga_state");
+		if (vga_state && (!GetBool(*vga_state, "include_palette", true, &result.vga_include_palette,
+		                         capture_path + ".vga_state", error) ||
+		                  !GetBool(*vga_state, "include_registers", true, &result.vga_include_registers,
+		                         capture_path + ".vga_state", error))) return false;
+		const JsonValue* framebuffer = capture->Find("framebuffer");
+		if (framebuffer && framebuffer->Find("mode")) {
+			std::string mode;
+			if (!GetString(*framebuffer, "mode", &mode, capture_path + ".framebuffer", error) || mode != "active") {
+				if (error && error->empty()) *error = capture_path + ".framebuffer.mode must be active";
+				return false;
+			}
+		}
+	}
+	const JsonValue* memory = version == 2 ? root.Find("memory") : capture->Find("memory");
+	if (memory) {
+		if (memory->type != JsonType::Array) {
+			if (error) *error = "configuration.capture.memory must be an array";
+			return false;
+		}
+		for (size_t i = 0; i < memory->array.size(); ++i) {
+			const JsonValue& item = memory->array[i];
+			const std::string path_prefix = std::string(version == 2 ? "configuration.memory[" : "configuration.capture.memory[") + std::to_string(i) + "]";
+			if (item.type != JsonType::Object) {
+				if (error) *error = path_prefix + " must be an object";
+				return false;
+			}
+			MemoryRegion region;
+			uint64_t segment = 0, offset = 0, length = 0;
+			if (!GetString(item, "name", &region.name, path_prefix, error) ||
+			    !SafeName(region.name) ||
+			    !ParseFormatHex(item, "segment", 0xffff, &segment, path_prefix, error) ||
+			    !ParseFormatHex(item, "offset", 0xffffffffULL, &offset, path_prefix, error) ||
+			    !ParseFormatHex(item, "length", 0xffffffffULL, &length, path_prefix, error)) {
+				if (error && error->empty()) *error = path_prefix + ".name must use letters, digits, underscore, or hyphen";
+				return false;
+			}
+			if (length == 0 || length > (std::numeric_limits<uint32_t>::max)()) {
+				if (error) *error = path_prefix + ".length must be between 1 and FFFFFFFF";
+				return false;
+			}
+			if (offset + length > (std::numeric_limits<uint32_t>::max)() + 1ULL) {
+				if (error) *error = path_prefix + ".offset + length exceeds the supported linear address range";
+				return false;
+			}
+			std::string format;
+			if (item.Find("format") && (!GetString(item, "format", &format, path_prefix, error) || format != "binary")) {
+				if (error && error->empty()) *error = path_prefix + ".format must be binary";
+				return false;
+			}
+			for (std::vector<MemoryRegion>::const_iterator previous = result.memory.begin(); previous != result.memory.end(); ++previous) {
+				std::string previous_name = previous->name;
+				std::string region_name = region.name;
+				std::transform(previous_name.begin(), previous_name.end(), previous_name.begin(), ::tolower);
+				std::transform(region_name.begin(), region_name.end(), region_name.begin(), ::tolower);
+				if (previous_name == region_name) {
+					if (error) *error = "duplicate memory region name: " + region.name;
+					return false;
+				}
+			}
+			region.segment = static_cast<uint16_t>(segment);
+			region.offset = static_cast<uint32_t>(offset);
+			region.length = static_cast<uint32_t>(length);
+			if (!ParseCadence(item, path_prefix, &region.every_n_captures, error)) return false;
+			result.memory.push_back(region);
+		}
+	}
+	if (!result.screenshot && !result.registers && !result.machine_state.enabled &&
+	    !result.vga_state.enabled && !result.framebuffer.enabled && !result.device_state.enabled &&
+        !result.x87_state.enabled && !result.render_surface.enabled && result.memory.empty()) {
+		if (error) *error = "at least one capture asset must be enabled";
+		return false;
+	}
+	const JsonValue* handling = root.Find("error_handling");
+	if (handling) {
+		if (handling->type != JsonType::Object) {
+			if (error) *error = "configuration.error_handling must be an object";
+			return false;
+		}
+		std::string policy;
+		if (handling->Find("on_capture_error") && !GetString(*handling, "on_capture_error", &policy, "configuration.error_handling", error)) return false;
+		if (!policy.empty() && policy != "continue" && policy != "stop") {
+			if (error) *error = "configuration.error_handling.on_capture_error must be continue or stop";
+			return false;
+		}
+		result.stop_on_error = policy == "stop";
+	}
+	if (version == 2) {
+		const JsonValue* policy = root.Find("on_capture_error");
+		if (policy) {
+			if (policy->type != JsonType::String || (policy->text != "continue" && policy->text != "stop")) {
+				if (error) *error = "configuration.on_capture_error must be continue or stop";
+				return false;
+			}
+			result.stop_on_error = policy->text == "stop";
+		}
+		const JsonValue* events = root.Find("events");
+		if (events) {
+			if (events->type != JsonType::Object ||
+			    !GetBool(*events, "enabled", false, &result.events_enabled, "configuration.events", error) ||
+			    !GetBool(*events, "video_mode_change", false, &result.event_video_mode_change, "configuration.events", error) ||
+			    !GetBool(*events, "process_exit", false, &result.event_process_exit, "configuration.events", error)) return false;
+			const JsonValue* addresses = events->Find("execution_addresses");
+			if (addresses) {
+				if (addresses->type != JsonType::Array) {
+					if (error) *error = "configuration.events.execution_addresses must be an array";
+					return false;
+				}
+				for (size_t i = 0; i < addresses->array.size(); ++i) {
+					const JsonValue& address = addresses->array[i];
+					const std::string address_path = "configuration.events.execution_addresses[" + std::to_string(i) + "]";
+					uint64_t selector = 0, offset = 0;
+					if (address.type != JsonType::Object ||
+					    !ParseFormatHex(address, "selector", 0xffff, &selector, address_path, error) ||
+					    !ParseFormatHex(address, "offset", 0xffffffffULL, &offset, address_path, error)) return false;
+					ExecutionAddress configured;
+					configured.selector = static_cast<uint16_t>(selector);
+					configured.offset = static_cast<uint32_t>(offset);
+                    if (!GetUnsigned(address, "occurrence", 0, false, &configured.occurrence, address_path, error)) return false;
+                    if (!GetBool(address, "stop_after_capture", false, &configured.stop_after_capture, address_path, error)) return false;
+                    if (!GetBool(address, "pair_source", false, &configured.pair_source, address_path, error) ||
+                        !GetBool(address, "pair_return", false, &configured.pair_return, address_path, error)) return false;
+                    if (address.Find("previous_offset")) {
+                        uint64_t previous = 0;
+                        if (!ParseFormatHex(address, "previous_offset", 0xffffffffULL, &previous, address_path, error)) return false;
+                        configured.has_previous_offset = true;
+                        configured.previous_offset = uint32_t(previous);
+                    }
+					result.execution_addresses.push_back(configured);
+				}
+			}
+		}
+    }
+	result.effective = root;
+    if (!result.reference_enabled) {
+        for (const auto& address : result.execution_addresses) {
+            if (address.occurrence || address.stop_after_capture || address.has_previous_offset || address.pair_source || address.pair_return) {
+                if (error) *error = "Occurrence/stop_after_capture require reference.enabled=true";
+                return false;
+            }
+        }
+    }
+    unsigned sources = 0, returns = 0;
+    for (const auto& address : result.execution_addresses) {
+        sources += address.pair_source;
+        returns += address.pair_return;
+        if ((address.pair_source && (!address.has_previous_offset || !address.occurrence || address.pair_return || address.stop_after_capture)) ||
+            (address.pair_return && (!address.stop_after_capture || address.occurrence != 1))) {
+            if (error) *error = "pair_source requires previous_offset and positive occurrence; pair_return requires occurrence=1 and stop_after_capture";
+            return false;
+        }
+    }
+    if ((sources || returns) && (sources != 1 || returns != 1 || !result.reference_enabled || !result.events_enabled)) {
+        if (error) *error = "Pairing requires exactly one source and one return with reference/events enabled";
+        return false;
+    }
+    if (sources) {
+        const ExecutionAddress* source = nullptr;
+        const ExecutionAddress* endpoint = nullptr;
+        for (const auto& address : result.execution_addresses) {
+            if (address.pair_source) source = &address;
+            if (address.pair_return) endpoint = &address;
+        }
+        if (source->selector != endpoint->selector || source->offset == endpoint->offset) {
+            if (error) *error = "Paired near-call source/return require the same CS and distinct offsets";
+            return false;
+        }
+    }
+    if (result.start_at_first_address && (!result.reference_enabled || !result.events_enabled || result.execution_addresses.empty())) {
+        if (error) *error = "start_at_first_address requires reference.enabled and execution address events";
+        return false;
+    }
+	*parsed = result;
+	if (error) error->clear();
+	return true;
+}
+
+uint64_t GuestTimeUs()
+{
+	const double ticks = PIC_FullIndex();
+	if (ticks <= 0.0) return 0;
+	const double micros = ticks * 1000.0;
+	if (micros >= static_cast<double>((std::numeric_limits<uint64_t>::max)())) return (std::numeric_limits<uint64_t>::max)();
+	return static_cast<uint64_t>(micros + 0.5);
+}
+
+std::string HostTime()
+{
+	const std::time_t now = std::time(NULL);
+	struct tm local;
+#ifdef WIN32
+	localtime_s(&local, &now);
+#else
+	localtime_r(&now, &local);
+#endif
+	char buffer[32];
+	strftime(buffer, sizeof(buffer), "%Y-%m-%d_%H-%M-%S", &local);
+	return buffer;
+}
+
+std::string IsoHostTime()
+{
+	const std::time_t now = std::time(NULL);
+	struct tm local;
+#ifdef WIN32
+	localtime_s(&local, &now);
+#else
+	localtime_r(&now, &local);
+#endif
+	char buffer[40];
+	strftime(buffer, sizeof(buffer), "%Y-%m-%dT%H:%M:%S", &local);
+	return buffer;
+}
+
+std::string FormatHex(const uint64_t value, const unsigned int width)
+{
+	std::ostringstream out;
+	out << std::uppercase << std::hex << std::setw(width) << std::setfill('0') << value;
+	return out.str();
+}
