+        ",\"pic\":" + AUTOCAP_PICStateJson() + ",\"keyboard\":" + AUTOCAP_KeyboardStateJson() + ",\"bios_timer\":" + AUTOCAP_BIOSTimerStateJson() + "}\n";
+}
+
+bool Capture(const bool manual, const uint64_t scheduled_us, const uint64_t missed_periods,
+		const char* event_trigger, std::string* capture_error)
+{
+	if (state != State::Running) return false;
+    FillFlags();
+	state = State::Capturing;
+	const uint64_t id = capture_sequence++;
+	const uint64_t actual_us = GuestTimeUs();
+	const std::string base_name = "capture_" + [&]() { std::ostringstream s; s << std::setw(6) << std::setfill('0') << id; return s.str(); }();
+	const std::string temporary = Join(session_path, base_name + ".tmp");
+	const std::string final_path = Join(session_path, base_name);
+	std::vector<Asset> assets;
+	bool all_ok = MakeDirectory(temporary);
+	if (!all_ok) {
+		if (capture_error) *capture_error = "Unable to create capture directory " + temporary;
+		state = State::Running;
+		return false;
+	}
+	std::string error;
+	const std::string complete_status = config.version == 2 ? "complete" : "ok";
+	const auto asset_ok = [&](const Asset& asset) { return asset.status == complete_status; };
+	const auto skipped_asset = [&](const std::string& name, const uint64_t cadence) {
+		Asset asset; asset.name = name; asset.status = "skipped"; asset.reason = "cadence";
+		asset.every_n_captures = cadence; assets.push_back(asset);
+	};
+	if (config.registers) {
+		if (config.version == 2 && !IsDue(id, config.registers_every_n_captures)) {
+			skipped_asset("registers", config.registers_every_n_captures);
+		} else {
+		Asset asset; asset.name = "registers"; asset.file = "registers.json";
+		asset.status = WriteRegisters(Join(temporary, asset.file), &asset.error) ? complete_status : "error";
+		RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+		all_ok = all_ok && asset_ok(asset);
+		assets.push_back(asset);
+		}
+	}
+	if (config.screenshot) {
+		if (config.version == 2 && !IsDue(id, config.screenshot_every_n_captures)) {
+			skipped_asset("screenshot", config.screenshot_every_n_captures);
+		} else {
+		Asset asset; asset.name = "screenshot"; asset.file = "screenshot.png";
+		RenderScreenshotGeometry screenshot_geometry;
+        const std::string surface_before = RENDER_CaptureSurfaceMetadata();
+		const bool renderer_geometry_available = config.version != 2 ||
+			RENDER_GetCurrentFrameScreenshotGeometry(&screenshot_geometry);
+		asset.status = RENDER_SaveCurrentFramePng(Join(temporary, asset.file), &asset.error) ? complete_status : "error";
+		if (asset_ok(asset)) {
+			RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+			if (config.version == 2) {
+				uint32_t png_width = 0, png_height = 0;
+				if (!renderer_geometry_available || !ReadPngGeometry(Join(temporary, asset.file), &png_width, &png_height)) {
+					asset.status = "partial";
+					asset.error = "Unable to read finalized PNG geometry";
+				} else {
+					asset.metadata = "{\"screenshot_geometry\": " +
+						ScreenshotGeometryMetadata(screenshot_geometry, png_width, png_height) +
+                        ",\"render_surface\":" + surface_before + "}";
+                    if (surface_before != RENDER_CaptureSurfaceMetadata()) {
+                        asset.status = "error"; asset.error = "Renderer changed during PNG serialization";
+                    }
+				}
+			}
+		}
+		all_ok = all_ok && asset_ok(asset);
+		assets.push_back(asset);
+		}
+	}
+	if (config.machine_state.enabled) {
+		if (!IsDue(id, config.machine_state.every_n_captures)) skipped_asset("machine_state", config.machine_state.every_n_captures);
+		else {
+			Asset asset; asset.name = "machine_state"; asset.file = "machine_state.json";
+			asset.status = WriteMachineState(Join(temporary, asset.file), &asset.error) ? complete_status : "error";
+			RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+			all_ok = all_ok && asset_ok(asset); assets.push_back(asset);
+		}
+	}
+	if (config.vga_state.enabled) {
+		if (!IsDue(id, config.vga_state.every_n_captures)) skipped_asset("vga_state", config.vga_state.every_n_captures);
+		else {
+			Asset asset; asset.name = "vga_state"; asset.file = "vga_state.json";
+			asset.status = WriteVgaState(Join(temporary, asset.file), &asset.error) ? complete_status : "error";
+			RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+			all_ok = all_ok && asset_ok(asset); assets.push_back(asset);
+		}
+	}
+	if (config.framebuffer.enabled) {
+		if (!IsDue(id, config.framebuffer.every_n_captures)) skipped_asset("framebuffer", config.framebuffer.every_n_captures);
+		else {
+			Asset asset; asset.name = "framebuffer"; asset.file = "framebuffer.bin";
+			asset.expected_size = vga.mem.memsize;
+			asset.metadata = "{\"provenance\": \"vga.mem.linear\", \"byte_size\": " + std::to_string(vga.mem.memsize) +
+				", \"width\": " + std::to_string(vga.draw.width) + ", \"height\": " + std::to_string(vga.draw.height) +
+				", \"pitch\": " + std::to_string(vga.draw.line_length) + ", \"bpp\": " + std::to_string(vga.draw.bpp) +
+				", \"display_address\": " + Escape(FormatHex(vga.draw.address, 8)) +
+				", \"pixel_format\": " + Escape(mode_texts[vga.mode]) + ", \"palette_dependency\": " +
+				((vga.draw.bpp == 8) ? "true" : "false") + ", \"draw_metadata_only_not_guest_pixel_layout\": true}";
+			if (!vga.mem.linear || !vga.mem.memsize) {
+				asset.status = "unavailable"; asset.reason = "no coherent VGA video-memory source";
+			} else {
+				asset.status = WriteFramebuffer(Join(temporary, asset.file), &asset.error) ? complete_status : "error";
+				RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+				all_ok = all_ok && asset_ok(asset);
+			}
+			assets.push_back(asset);
+		}
+	}
+    if (config.render_surface.enabled) {
+        Asset asset;
+        asset.name = "render_surface"; asset.file = "render_surface.bin";
+        if (!IsDue(id, config.render_surface.every_n_captures)) {
+            asset.status = "skipped"; asset.reason = "cadence";
+            asset.file.clear();
+            asset.every_n_captures = config.render_surface.every_n_captures;
+        } else {
+            asset.metadata = RENDER_CaptureSurfaceMetadata();
+            asset.status = RENDER_SaveCaptureSurface(Join(temporary, asset.file), &asset.error) ? complete_status : "error";
+            if (asset.metadata != RENDER_CaptureSurfaceMetadata()) {
+                asset.status = "error"; asset.error = "Renderer state changed while serializing cache";
+            }
+            RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+            all_ok = all_ok && asset_ok(asset);
+        }
+        assets.push_back(asset);
+    }
+    const AssetConfiguration* extra_configs[] = {&config.device_state, &config.x87_state};
+    const char* extra_names[] = {"device_state", "x87_state"};
+    for (unsigned int n = 0; n < 2; ++n) {
+        if (!extra_configs[n]->enabled) continue;
+        Asset asset;
+        asset.name = extra_names[n];
+        asset.file = asset.name + ".json";
+        if (!IsDue(id, extra_configs[n]->every_n_captures)) {
+            asset.status = "skipped"; asset.reason = "cadence";
+            asset.file.clear();
+            asset.every_n_captures = extra_configs[n]->every_n_captures;
+        } else {
+            asset.status = WriteText(Join(temporary, asset.file), n == 0 ? DeviceStateJson() : X87StateJson(), &asset.error) ? complete_status : "error";
+            RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+            all_ok = all_ok && asset_ok(asset);
+        }
+        assets.push_back(asset);
+    }
+    if (config.reference_enabled) {
+        Asset asset;
+        asset.name = "reference_trace";
+        asset.file = "reference_trace.jsonl";
+        std::ostringstream trace;
+        for (const auto& event : reference_events) trace << event << '\n';
+        asset.status = WriteText(Join(temporary, asset.file), trace.str(), &asset.error) ? complete_status : "error";
+        if (dropped_events && asset.error.empty()) {
+            asset.status = "partial";
+            asset.error = "Trace overflow: " + std::to_string(dropped_events) + " events dropped; NOT a complete reference trace";
+        }
+        RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+        all_ok = all_ok && asset_ok(asset);
+        assets.push_back(asset);
+    }
+	for (std::vector<MemoryRegion>::const_iterator region = config.memory.begin(); region != config.memory.end(); ++region) {
+		Asset asset;
+		asset.name = region->name;
+		if (config.version == 2 && !IsDue(id, region->every_n_captures)) {
+			asset.status = "skipped"; asset.reason = "cadence"; asset.every_n_captures = region->every_n_captures;
+			assets.push_back(asset);
+			continue;
+		}
+		asset.expected_size = region->length;
+		asset.has_address = true;
+		asset.segment = region->segment;
+		asset.offset = region->offset;
+		std::ostringstream file;
+		file << "memory_" << region->name << "_" << FormatHex(region->segment, 4) << "_"
+		     << FormatHex(region->offset, 8) << "_" << FormatHex(region->length, 8) << ".bin";
+		asset.file = file.str();
+		uint64_t unreadable = 0;
+		asset.status = DEBUG_DumpMemoryBinary(region->segment, region->offset, region->length,
+		                                      Join(temporary, asset.file), &unreadable, &asset.error) ? complete_status : "error";
+		RecordFinalizedAssetSize(Join(temporary, asset.file), &asset);
+		if (unreadable) {
+			asset.status = "partial";
+			asset.error = std::to_string(unreadable) + " unreadable bytes were zero-filled";
+		}
+		all_ok = all_ok && asset_ok(asset);
+		assets.push_back(asset);
+	}
+	const uint64_t lateness = manual || actual_us < scheduled_us ? 0 : actual_us - scheduled_us;
+	std::ostringstream json;
+	json << "{\n  \"format_version\": " << config.version << ",\n  \"capture\": " << id
+	     << ",\n  \"status\": " << Escape(all_ok ? "complete" : "partial")
+	     << ",\n  \"trigger\": {\"type\": " << Escape(event_trigger ? "event" : (manual ? "manual" : "emulated_time"))
+	     << ", \"scheduled_us\": " << (manual ? actual_us : scheduled_us)
+	     << ", \"actual_us\": " << actual_us << ", \"lateness_us\": " << lateness
+	     << ", \"missed_intervals\": " << (manual ? 0 : missed_periods);
+	if (event_trigger) json << ", \"event\": " << Escape(event_trigger);
+	json << "},\n"
+	     << "  \"process\": {\"executable\": " << Escape(process_name) << ", \"psp\": " << Escape(FormatHex(tracked_psp, 4)) << "},\n"
+	     << "  \"time\": {\"process_elapsed_us\": " << (actual_us - process_start_us)
+	     << ", \"capture_session_elapsed_us\": " << (actual_us - session_start_us) << "},\n"
+	     << "  \"cpu\": {\"cycle_mode\": " << Escape(CPU_CycleAutoAdjust ? "auto" : "fixed")
+	     << ", \"configured_cycles\": " << static_cast<uint64_t>(CPU_CycleMax) << "},\n";
+	if (config.version == 2) {
+		json << "  \"execution\": {\"cs\": " << Escape(FormatHex(SegValue(cs), 4))
+		     << ", \"eip\": " << Escape(FormatHex(reg_eip, 8))
+		     << ", \"selector_base\": " << Escape(FormatHex(SegPhys(cs), 8))
+		     << ", \"linear_instruction_address\": " << Escape(FormatHex(SegPhys(cs) + reg_eip, 8))
+             << ", \"instruction_counter\": " << (config.reference_enabled ? std::to_string(instruction_boundary_count) : "null")
+             << ", \"instruction_counter_kind\": " << Escape(config.reference_enabled ? "normal_core_pre_dispatch_boundaries_not_retired_instructions" : "unavailable") << "},\n";
+        json << "  \"captureBoundary\": {\"kind\":" << Escape(at_instruction_boundary ? "normal_core_pre_instruction" : "cpu_dispatch_safe_point")
+             << ",\"address_occurrence\":" << selected_occurrence
+             << ",\"cpu_core\":" << Escape(cpudecoder == CPU_Core_Normal_Run ? "normal" : "other")
+             << ",\"trace_interval_start_boundary\":" << trace_interval_start
+             << ",\"dropped_events\":" << dropped_events
+             << ",\"cpu_settings_override\":" << (cpu_settings_override ? "true" : "false")
+             << ",\"cpu_trace_incomplete\":" << (cpu_trace_incomplete ? "true" : "false")
+             << ",\"invocation_pair\":{\"active\":" << (invocation_pair.active ? "true" : "false")
+             << ",\"source_boundary\":" << invocation_pair.source_boundary
+             << ",\"source_capture\":" << invocation_pair.source_capture
+             << ",\"source_esp\":" << invocation_pair.source_esp
+             << ",\"caller_esp\":" << invocation_pair.caller_esp
+             << ",\"cs\":" << invocation_pair.cs << ",\"cs_base\":" << invocation_pair.cs_base
+             << ",\"ss\":" << invocation_pair.ss << ",\"ss_base\":" << invocation_pair.ss_base
+             << ",\"kind\":\"observed_32bit_near_call_stack_context_not_retirement_proof\"}"
+             << ",\"display_synchronous_with_cpu\":false,\"control_flow_tail\":[";
+        for (size_t n = 0; n < boundary_tail.size(); ++n) { if (n) json << ','; json << boundary_tail[n]; }
+        json << "]},\n";
+	}
+	json << "  \"assets\": {\n";
+	for (size_t i = 0; i < assets.size(); ++i) {
+		const Asset& asset = assets[i];
+		json << "    " << Escape(asset.name) << ": {\"status\": " << Escape(asset.status)
+		     << ", \"file\": " << Escape(asset.file) << ", \"size\": " << asset.size;
+		if (asset.expected_size) json << ", \"expected_size\": " << asset.expected_size;
+		if (asset.has_address) json << ", \"segment\": " << Escape(FormatHex(asset.segment, 4))
+		                           << ", \"offset\": " << Escape(FormatHex(asset.offset, 8));
+		if (!asset.reason.empty()) json << ", \"reason\": " << Escape(asset.reason);
+		if (asset.status == "skipped") json << ", \"every_n_captures\": " << asset.every_n_captures;
+		if (!asset.metadata.empty()) json << ", \"metadata\": " << asset.metadata;
+		if (!asset.error.empty()) json << ", \"error\": " << Escape(asset.error);
+		json << "}" << (i + 1 == assets.size() ? "\n" : ",\n");
+	}
+	json << "  }\n}\n";
+	if (!WriteText(Join(temporary, "capture.json"), json.str(), &error)) {
+		all_ok = false;
+		LOG_MSG("AUTOCAP: %s", error.c_str());
+		if (capture_error) *capture_error = error;
+		state = State::Running;
+		if (config.stop_on_error) AUTOCAP_Stop("capture_metadata_error");
+		return false;
+	}
+#ifdef WIN32
+	const bool finalized = MoveFileExA(temporary.c_str(), final_path.c_str(), MOVEFILE_WRITE_THROUGH) != 0;
+#else
+	const bool finalized = rename(temporary.c_str(), final_path.c_str()) == 0;
+#endif
+	if (!finalized) {
+		all_ok = false;
+		if (capture_error) *capture_error = "Unable to finalize capture directory " + temporary;
+		LOG_MSG("AUTOCAP: Unable to finalize capture directory %s", temporary.c_str());
+	} else {
+		++completed_captures;
+        // A failed/partial capture keeps the buffered events for recovery.
+        if (all_ok) { reference_events.clear(); dropped_events = 0; trace_interval_start = instruction_boundary_count; }
+	}
+	LOG_MSG("AUTOCAP: Capture %llu %s", static_cast<unsigned long long>(id), all_ok ? "complete" : "partial");
+	state = State::Running;
+	if (!all_ok && capture_error && capture_error->empty()) *capture_error = "One or more capture assets failed";
+	if (!all_ok && config.stop_on_error) AUTOCAP_Stop("capture_error");
+	return all_ok;
+}
