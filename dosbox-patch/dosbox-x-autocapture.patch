+	}
+	const size_t split = filename.find_last_of("/\\");
+	if (split == std::string::npos) {
+		if (error) *error = "Screenshot filename must include its capture directory";
+		return false;
+	}
+	struct stat info;
+	if (stat(filename.c_str(), &info) == 0) {
