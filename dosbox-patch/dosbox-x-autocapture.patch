+
+namespace {
+
+using dosbox_agent::JsonType;
+using dosbox_agent::JsonValue;
+
+struct MemoryRegion {
+	std::string name;
+	uint16_t segment = 0;
+	uint32_t offset = 0;
+	uint32_t length = 0;
+	uint64_t every_n_captures = 1;
+};
+
+struct AssetConfiguration {
+	bool enabled = false;
+	uint64_t every_n_captures = 1;
+};
+
+struct ExecutionAddress {
+	uint16_t selector = 0;
+	uint32_t offset = 0;
+    uint64_t occurrence = 0; // 0 = every occurrence; numbered from attachment.
+    uint64_t seen = 0;
+    bool stop_after_capture = false;
+    bool has_previous_offset = false;
+    uint32_t previous_offset = 0;
+    // Paired observation of a 32-bit near CALL/RET with no argument cleanup.
+    bool pair_source = false;
+    bool pair_return = false;
