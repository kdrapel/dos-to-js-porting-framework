+
+bool RENDER_SaveCaptureSurface(const std::string& filename, std::string* error) {
+    const uint64_t bytes = uint64_t(render.scale.cachePitch) * render.src.height;
+    if (!render.active || !scalerSourceCacheBuffer || bytes == 0 || bytes > scalerSourceCacheBufferSize) {
+        if (error) *error = "Renderer source cache unavailable or size exceeds allocation";
+        return false;
+    }
+    std::ofstream out(filename.c_str(), std::ios::binary | std::ios::trunc);
+    if (out) out.write(reinterpret_cast<const char*>(scalerSourceCacheBuffer), std::streamsize(bytes));
+    out.close();
+    if (!out) { if (error) *error = "Unable to finalize renderer source cache"; return false; }
+    return true;
+}
