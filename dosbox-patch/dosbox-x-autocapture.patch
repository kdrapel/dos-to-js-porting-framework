+bool RENDER_GetCurrentFrameScreenshotGeometry(RenderScreenshotGeometry* geometry) {
+	if (!geometry || !render.active || !scalerSourceCacheBuffer || !render.src.width || !render.src.height)
+		return false;
+	geometry->source_width = static_cast<uint32_t>(render.src.width);
+	geometry->source_height = static_cast<uint32_t>(render.src.height);
+	geometry->source_bpp = static_cast<uint32_t>(render.src.bpp);
+	/* CAPTURE_AddImage only receives an explicit doubling flag when one axis differs. */
+	geometry->double_width = render.src.dblw && render.src.dblw != render.src.dblh;
+	geometry->double_height = render.src.dblh && render.src.dblw != render.src.dblh;
+	geometry->output_width = geometry->source_width * (geometry->double_width ? 2u : 1u);
+	geometry->output_height = geometry->source_height * (geometry->double_height ? 2u : 1u);
+	return true;
+}
+
+bool RENDER_SaveCurrentFramePng(const std::string& filename, std::string* error) {
+#if (C_SSHOT)
