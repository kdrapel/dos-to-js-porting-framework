+bool AUTOCAP_GenerateExampleConfiguration(const std::string& folder, std::string* path, std::string* error)
+{
+	if (path) path->clear();
+	if (error) error->clear();
+	if (!IsDirectory(folder)) {
+		if (error) *error = "Choose an existing folder for the example configuration.";
+		return false;
+	}
+	const std::string output = Join(folder, "automatic-captures");
+	const std::string contents =
+		"{\n"
+		"  \"version\": 1,\n"
+		"  \"output\": { \"directory\": " + Escape(output) + " },\n"
+		"  \"trigger\": { \"type\": \"emulated_time\", \"interval_ms\": 2000, \"initial_delay_ms\": 1000 },\n"
+		"  \"process\": { \"mode\": \"current_or_next\", \"on_exit\": \"stop\" },\n"
+		"  \"capture\": {\n"
+		"    \"screenshot\": { \"enabled\": true, \"format\": \"png\" },\n"
+		"    \"registers\": { \"enabled\": true, \"format\": \"json\" },\n"
+		"    \"memory\": [\n"
+		"      { \"name\": \"main\", \"segment\": \"0008\", \"offset\": \"00000000\", \"length\": \"00040000\", \"format\": \"binary\" }\n"
+		"    ]\n"
+		"  },\n"
+		"  \"error_handling\": { \"on_capture_error\": \"continue\" }\n"
+		"}\n";
+	for (unsigned int suffix = 1; suffix < 1000; ++suffix) {
+		const std::string filename = suffix == 1 ? "automatic-capture-example.json" :
+			"automatic-capture-example-" + std::to_string(suffix) + ".json";
+		const std::string candidate = Join(folder, filename);
+		bool exists = false;
+		if (WriteNewText(candidate, contents, &exists)) {
+			if (path) *path = candidate;
+			LOG_MSG("AUTOCAP: Example configuration created: %s", candidate.c_str());
+			return true;
+		}
+		if (!exists) {
+			if (error) *error = "Unable to create example configuration in " + folder;
+			return false;
+		}
+	}
+	if (error) *error = "Too many example configurations in " + folder;
+	return false;
+}
+
+void AUTOCAP_SelectConfiguration()
+{
+	std::string error;
+	if (!config_path.empty() && ParseConfiguration(config_path, &config, &error)) {
+		LOG_MSG("AUTOCAP: Configuration loaded: %s", config_path.c_str());
+		return;
+	}
+	if (error.empty()) error = "Select a valid automatic capture JSON file.";
+	systemmessagebox("Automatic capture", error.c_str(), "ok", "warning", 1);
+}
+
+void AUTOCAP_SetConfigurationPath(const std::string& path)
+{
+	if (state != State::Disabled) {
+		systemmessagebox("Automatic capture", "Stop the active session before changing its configuration.", "ok", "warning", 1);
+		return;
+	}
+	Configuration loaded;
+	std::string error;
+	if (!path.empty() && ParseConfiguration(path, &loaded, &error)) {
+		config_path = path;
+		config = loaded;
+		LOG_MSG("AUTOCAP: Configuration selected: %s", config_path.c_str());
+		AUTOCAP_RefreshMenuItems();
+	} else if (!path.empty()) {
+		systemmessagebox("Automatic capture", error.c_str(), "ok", "warning", 1);
+	}
+}
+
+bool AUTOCAP_Start(std::string* error)
+{
+	if (error) error->clear();
+	if (state != State::Disabled) {
+		if (error) *error = "Automatic capture is already active";
+		return false;
+	}
+	if (dos_kernel_disabled || RunningProgram == "LOADLIN") {
+		if (error) *error = "Automatic capture requires the DOS kernel and PSP tracking";
+		return false;
+	}
+	Configuration loaded;
+	if (config_path.empty()) {
+		if (error) *error = "Select an automatic capture configuration first";
+		return false;
+	}
+	if (!ParseConfiguration(config_path, &loaded, error)) return false;
+    cpu_settings_override = cpu_trace_incomplete = false;
+    if (loaded.reference_enabled && !CheckReferenceCPUSettings(loaded)) {
+        if (error) error->clear(); // The warning already explained cancellation.
+        return false;
+    }
+	config = loaded;
+	if (!CreateSessionDirectory(error)) return false;
+	state = State::Armed;
+	capture_sequence = 0;
+	completed_captures = 0;
+	manual_pending = false;
+	periodic_pending = false;
+	video_mode_initialized = false;
+	execution_address_latched = false;
+    instruction_boundary_count = event_sequence = dropped_events = trace_interval_start = 0;
+    reference_events.clear();
+    boundary_tail.clear();
+    reference_recording = !config.start_at_first_address;
+    previous_boundary_valid = false;
+    selected_occurrence = 0;
+    invocation_pair = InvocationPair{};
+	stop_reason.clear();
+	session_created_host_time = IsoHostTime();
+	session_start_us = GuestTimeUs();
+	process_start_us = 0;
+	tracked_psp = 0;
+	process_name.clear();
+	if (!WriteAtomic(Join(session_path, "session.json"), SessionManifest("armed"), error)) {
+		state = State::Disabled;
+		return false;
+	}
+	if (!IsShellProcess()) Attach(RunningProgram.c_str(), dos.psp());
+	AUTOCAP_RefreshMenuItems();
+	LOG_MSG("AUTOCAP: Session started: %s", session_path.c_str());
+	return true;
+}
+
+void AUTOCAP_Stop(const char* reason)
+{
+	if (state == State::Disabled) return;
+	stop_reason = reason ? reason : "user";
+	std::string error;
+    if (config.reference_enabled && !reference_events.empty()) {
+        std::ostringstream trace;
+        for (const auto& event : reference_events) trace << event << '\n';
+        if (!WriteText(Join(session_path, "reference_tail.jsonl"), trace.str(), &error)) {
+            LOG_MSG("AUTOCAP: Unable to save reference trace tail: %s", error.c_str());
+            stop_reason += "_trace_tail_write_failed";
+        }
+    }
+	if (!session_path.empty() && !WriteAtomic(Join(session_path, "session.json"), SessionManifest("stopped"), &error))
+		LOG_MSG("AUTOCAP: %s", error.c_str());
+	LOG_MSG("AUTOCAP: Session stopped (%s)", stop_reason.c_str());
+	state = State::Disabled;
+	manual_pending = false;
+	periodic_pending = false;
+	tracked_psp = 0;
+	AUTOCAP_RefreshMenuItems();
+}
+
+void AUTOCAP_ReloadConfiguration(std::string* error)
+{
+	if (state != State::Disabled) {
+		if (error) *error = "Stop automatic capture before reloading its configuration";
+		return;
+	}
+	Configuration loaded;
+	if (config_path.empty()) {
+		if (error) *error = "Select an automatic capture configuration first";
+		return;
+	}
+	if (!ParseConfiguration(config_path, &loaded, error)) return;
+	config = loaded;
+	if (error) error->clear();
+	LOG_MSG("AUTOCAP: Configuration loaded: %s", config_path.c_str());
+	AUTOCAP_RefreshMenuItems();
+}
+
+void AUTOCAP_RequestManualCapture()
+{
+	if (state == State::Running || state == State::Capturing) manual_pending = true;
+	else LOG_MSG("AUTOCAP: Capture now requires an attached running process");
+}
+
+std::string AUTOCAP_FormatStatus()
+{
+	const char* label = state == State::Disabled ? "Disabled" : state == State::Armed ? "Armed" : state == State::Running ? "Running" : "Capturing";
+	std::ostringstream out;
+	out << "Automatic capture\n\nStatus: " << label
+	    << "\nConfiguration: " << (config_path.empty() ? "(not selected)" : config_path)
+	    << "\nSession: " << (session_path.empty() ? "(none)" : session_path);
+	if (tracked_psp) {
+		const uint64_t now = GuestTimeUs();
+		const uint64_t elapsed_next = next_periodic_us >= process_start_us ? next_periodic_us - process_start_us : 0;
+		out << "\nProcess: " << process_name << " PSP=" << FormatHex(tracked_psp, 4)
+		    << "\nProcess elapsed: " << ((now - process_start_us) / 1000000) << "."
+		    << std::setw(3) << std::setfill('0') << ((now - process_start_us) / 1000) % 1000 << " s"
+		    << "\nCaptures: " << completed_captures
+		    << "\nNext capture deadline: " << (elapsed_next / 1000000) << "."
+		    << std::setw(3) << ((elapsed_next / 1000) % 1000) << " s after process start";
+	}
+	return out.str();
+}
+
+void AUTOCAP_OnProgramStart(const char* executable, const uint16_t psp, const uint16_t parent_psp)
+{
+	(void)parent_psp;
+	if (state == State::Armed) Attach(executable, psp);
+}
+
+void AUTOCAP_OnProgramExit(const uint16_t psp)
+{
+	if (state == State::Running && psp == tracked_psp) {
+		if (config.events_enabled && config.event_process_exit) {
+			std::string error;
+			Capture(false, GuestTimeUs(), 0, "process_exit", &error);
+		}
+		AUTOCAP_Stop("process_exit");
+	}
+}
+
+void AUTOCAP_PumpSafePoint()
+{
+	if (state != State::Running) return;
+    if (config.reference_enabled &&
+        (cpudecoder != acknowledged_decoder || CPU_CycleAutoAdjust != acknowledged_auto_cycles ||
+         CPU_AutoDetermineMode != acknowledged_auto_mode ||
+         (!CPU_CycleAutoAdjust && CPU_CycleMax != acknowledged_cycles))) {
+        // A valid starting fixed count is also the baseline when no count was specified.
+        Configuration expected = config;
+        if (!expected.expected_cycles && !acknowledged_auto_cycles && acknowledged_cycles > 0)
+            expected.expected_cycles = uint64_t(acknowledged_cycles);
+        if (!CheckReferenceCPUSettings(expected)) {
+            AUTOCAP_Stop("reference_cpu_settings_warning_cancelled");
+            return;
+        }
+    }
+	const uint64_t now = GuestTimeUs();
+	if (config.events_enabled) {
+		if (config.event_video_mode_change && video_mode_initialized && vga.mode != attached_video_mode) {
+			const VGAModes previous = attached_video_mode;
+			attached_video_mode = vga.mode;
+			std::string error;
+			Capture(false, now, 0, "video_mode_change", &error);
+			LOG_MSG("AUTOCAP: video mode changed from %u to %u", static_cast<unsigned int>(previous), static_cast<unsigned int>(vga.mode));
+		}
+        if (!config.reference_enabled) {
+		bool execution_address_matched = false;
+		for (std::vector<ExecutionAddress>::const_iterator address = config.execution_addresses.begin();
+		     address != config.execution_addresses.end(); ++address) {
+			if (address->selector == SegValue(cs) && address->offset == reg_eip) {
+				execution_address_matched = true;
+				break;
+			}
+		}
+		if (execution_address_matched && !execution_address_latched) {
+			std::string error;
+			Capture(false, now, 0, "execution_address", &error);
+		}
+		execution_address_latched = execution_address_matched;
+        }
+	}
+	if (!periodic_pending && now >= next_periodic_us) {
+		periodic_pending = true;
+		pending_scheduled_us = next_periodic_us;
+		pending_missed_periods = 0;
+		do {
+			if (next_periodic_us > (std::numeric_limits<uint64_t>::max)() - config.interval_us) {
+				next_periodic_us = (std::numeric_limits<uint64_t>::max)();
+				break;
+			}
+			next_periodic_us += config.interval_us;
+			if (next_periodic_us <= now) ++pending_missed_periods;
+		} while (next_periodic_us <= now);
+	}
+	if (periodic_pending) {
+		periodic_pending = false;
+		std::string error;
+		Capture(false, pending_scheduled_us, pending_missed_periods, NULL, &error);
+		pending_missed_periods = 0;
+	}
+	if (manual_pending && state == State::Running) {
+		manual_pending = false;
+		std::string error;
+		Capture(true, now, 0, NULL, &error);
+	}
+}
+
+bool AUTOCAP_WantsInstructionBoundary()
+{
+    return state == State::Running && config.reference_enabled;
+}
+
+void AUTOCAP_OnInstructionBoundary()
+{
+    if (!AUTOCAP_WantsInstructionBoundary()) return;
+    ++instruction_boundary_count;
+    selected_occurrence = 0;
+    // Periodic snapshots need only a counter; avoid clocks, JSON, flags and
+    // deque allocation at every instruction when no detailed tracing is requested.
+    if (!config.trace_instructions && (!config.events_enabled || config.execution_addresses.empty())) return;
+    FillFlags();
+    const auto context = EventContext();
+    boundary_tail.push_back("{" + context + "}");
+    if (boundary_tail.size() > 64) boundary_tail.pop_front();
+    const auto record_boundary = [&]() {
+        std::ostringstream out;
+        out << "{\"kind\":\"instruction_boundary\"," << context
+            << ",\"eax\":" << reg_eax << ",\"ebx\":" << reg_ebx << ",\"ecx\":" << reg_ecx
+            << ",\"edx\":" << reg_edx << ",\"esi\":" << reg_esi << ",\"edi\":" << reg_edi
+            << ",\"ebp\":" << reg_ebp << ",\"eflags\":" << reg_flags;
+#if C_FPU
+        out << ",\"x87_cw\":" << fpu.cw.reg << ",\"x87_sw\":" << fpu.sw.reg;
+#endif
+        out << '}';
+        AppendEvent(out.str());
+    };
+    const bool boundary_recorded = config.trace_instructions && reference_recording;
+    if (boundary_recorded) record_boundary();
+    const bool have_previous = previous_boundary_valid;
+    const auto previous_cs = previous_boundary_cs;
+    const auto previous_eip = previous_boundary_eip;
+    const auto caller_ss = previous_boundary_ss;
+    const auto caller_ss_base = previous_boundary_ss_base;
+    const auto caller_esp = previous_boundary_esp;
+    const auto caller_stack_big = previous_stack_big;
+    previous_boundary_ss = SegValue(ss);
+    previous_boundary_ss_base = SegPhys(ss);
+    previous_boundary_esp = reg_esp;
+    previous_stack_big = cpu.stack.big;
+    previous_boundary_cs = SegValue(cs);
+    previous_boundary_eip = reg_eip;
+    previous_boundary_valid = true;
+    if (!config.events_enabled) return;
+    const bool paired_return_matches = invocation_pair.active && invocation_pair.source_captured &&
+        cpu.stack.big && SegValue(cs) == invocation_pair.cs && SegPhys(cs) == invocation_pair.cs_base &&
+        SegValue(ss) == invocation_pair.ss && SegPhys(ss) == invocation_pair.ss_base &&
+        reg_esp == invocation_pair.caller_esp;
+    for (auto& address : config.execution_addresses) {
+        if (address.pair_return && !paired_return_matches) continue;
+        if (address.selector == SegValue(cs) && address.offset == reg_eip &&
+            (!address.has_previous_offset || (have_previous && previous_cs == address.selector && previous_eip == address.previous_offset))) ++address.seen;
+    }
+    for (auto& address : config.execution_addresses) {
+        if (address.pair_return && !paired_return_matches) continue;
+        if (address.pair_source && invocation_pair.active) continue;
+        if (address.selector != SegValue(cs) || address.offset != reg_eip) continue;
+        if (address.has_previous_offset && (!have_previous || previous_cs != address.selector || previous_eip != address.previous_offset)) continue;
+        if (address.occurrence && address.occurrence != address.seen) continue;
+        if (address.pair_source) {
+            if (!have_previous || !caller_stack_big || !cpu.stack.big || caller_ss != SegValue(ss) ||
+                caller_ss_base != SegPhys(ss) || uint32_t(reg_esp + 4u) != caller_esp) {
+                AUTOCAP_Stop("reference_source_near_call_stack_mismatch");
+                return;
+            }
+            invocation_pair.active = true;
+            invocation_pair.cs = SegValue(cs); invocation_pair.cs_base = SegPhys(cs);
+            invocation_pair.ss = SegValue(ss); invocation_pair.ss_base = SegPhys(ss);
+            invocation_pair.caller_esp = caller_esp; invocation_pair.source_esp = reg_esp;
+            invocation_pair.source_boundary = instruction_boundary_count;
+            invocation_pair.source_capture = capture_sequence;
+        }
+        selected_occurrence = address.seen;
+        reference_recording = true;
+        if (config.trace_instructions && !boundary_recorded) record_boundary();
+        at_instruction_boundary = true;
+        std::string error;
+        const bool success = Capture(false, GuestTimeUs(), 0, "execution_address", &error);
+        at_instruction_boundary = false;
+        if (address.pair_source) {
+            invocation_pair.source_captured = success;
+            if (!success) { AUTOCAP_Stop("reference_pair_source_capture_failed"); return; }
+        }
+        if (address.stop_after_capture) AUTOCAP_Stop(success ? "reference_endpoint_captured" : "reference_endpoint_capture_failed");
+        break; // duplicate address specifications do not produce duplicate captures
+    }
+}
+
+void AUTOCAP_RecordInstructionFetch(const uint32_t value, const unsigned int width)
+{
+    if (!AUTOCAP_WantsInstructionBoundary() || !reference_recording || !config.trace_instructions) return;
+    AppendEvent("{\"kind\":\"instruction_fetch\"," + EventContext() +
+                ",\"width\":" + std::to_string(width) + ",\"little_endian_value\":" + std::to_string(value) + "}");
+}
+
+void AUTOCAP_RecordIO(const bool write, const uint32_t port, const uint32_t value, const unsigned int width)
+{
+    if (!AUTOCAP_WantsInstructionBoundary() || !reference_recording) return;
+    if (port != 0x40 && port != 0x41 && port != 0x42 && port != 0x43 &&
+        port != 0x20 && port != 0x21 && port != 0xa0 && port != 0xa1 && port != 0x60 && port != 0x64) return;
+    const std::string after = port >= 0x40 && port <= 0x43 ? AUTOCAP_PITStateJson() :
+        (port == 0x60 || port == 0x64 ? AUTOCAP_KeyboardStateJson() : AUTOCAP_PICStateJson());
+    AppendEvent("{\"kind\":\"io_dispatch\"," + EventContext() + ",\"direction\":" + Escape(write ? "out" : "in") +
+                ",\"port\":" + std::to_string(port) + ",\"width\":" + std::to_string(width) +
+                ",\"value\":" + std::to_string(value) + ",\"origin\":\"io_dispatch_may_include_bios_internal_calls\",\"device_after\":" + after + "}");
+}
+
+void AUTOCAP_RecordBIOSTimerEvent(const char* kind)
+{
+    if (!AUTOCAP_WantsInstructionBoundary() || !reference_recording) return;
+    AppendEvent("{\"kind\":" + Escape(kind) + "," + EventContext() +
