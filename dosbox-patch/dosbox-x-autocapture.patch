+bool CheckReferenceCPUSettings(const Configuration& requested)
+{
+    const bool normal = cpudecoder == CPU_Core_Normal_Run && !(CPU_AutoDetermineMode & CPU_AUTODETERMINE_CORE);
+    const bool fixed = !CPU_CycleAutoAdjust && !(CPU_AutoDetermineMode & CPU_AUTODETERMINE_CYCLES) && CPU_CycleMax > 0;
+    const bool count_matches = !requested.expected_cycles ||
+        (CPU_CycleMax > 0 && uint64_t(CPU_CycleMax) == requested.expected_cycles);
+    if (!normal || !fixed || !count_matches) {
+        std::ostringstream message;
+        message << "Expected: core=normal, cycles=fixed";
+        if (requested.expected_cycles) message << ' ' << requested.expected_cycles;
+        message << "\nActual core: " << (cpudecoder == CPU_Core_Normal_Run ? "normal" : "other (not normal)")
+            << ((CPU_AutoDetermineMode & CPU_AUTODETERMINE_CORE) ? " (automatic core switching enabled)" : "")
+            << "\nActual cycles: " << (CPU_CycleAutoAdjust ? "auto/max " : "fixed ") << CPU_CycleMax
+            << ((CPU_AutoDetermineMode & CPU_AUTODETERMINE_CYCLES) ? " (automatic cycle switching enabled)" : "")
+            << "\n\nIgnoring this warning risks incomplete or unreliable captures."
+            << " Instruction tracing and paired address triggers require the normal core."
+            << "\n\nYes: Ignore and continue capturing.\nNo: Cancel capture.";
+        if (!systemmessagebox("Automatic capture: CPU settings warning", message.str().c_str(), "yesno", "warning", 0))
+            return false;
+        cpu_settings_override = true;
+        cpu_trace_incomplete = true;
+    }
+    acknowledged_decoder = cpudecoder;
+    acknowledged_auto_cycles = CPU_CycleAutoAdjust;
+    acknowledged_auto_mode = CPU_AutoDetermineMode;
+    acknowledged_cycles = CPU_CycleMax;
+    return true;
+}
