+std::string SessionManifest(const char* status)
+{
+	std::ostringstream json;
+	json << "{\n  \"format_version\": " << config.version << ",\n"
+	     << "  \"created_host_time\": " << Escape(session_created_host_time) << ",\n"
+	     << "  \"dosbox_x_version\": " << Escape(VERSION) << ",\n"
+	     << "  \"status\": " << Escape(status) << ",\n"
+	     << "  \"stop_reason\": " << Escape(stop_reason) << ",\n"
+	     << "  \"program\": {\"executable\": " << Escape(process_name)
+	     << ", \"psp\": " << Escape(tracked_psp ? FormatHex(tracked_psp, 4) : std::string()) << "},\n"
+	     << "  \"process_start_us\": " << process_start_us << ",\n"
+	     << "  \"captures\": " << completed_captures << ",\n";
+	if (config.version == 2) {
+		json << "  \"capabilities\": {\"machine_state\": true, \"vga_state\": true, \"framebuffer\": true, \"device_state\": true, \"x87_state\": true, \"render_surface\": true, \"normal_core_instruction_boundary\": true, \"instruction_counter\": " << (config.reference_enabled ? "true" : "false") << "},\n"
+		     << "  \"asset_cadence\": {\"registers\": " << config.registers_every_n_captures
+		     << ", \"screenshot\": " << config.screenshot_every_n_captures
+		     << ", \"machine_state\": " << config.machine_state.every_n_captures
+		     << ", \"vga_state\": " << config.vga_state.every_n_captures
+		     << ", \"framebuffer\": " << config.framebuffer.every_n_captures
+             << ", \"device_state\": " << config.device_state.every_n_captures
+             << ", \"x87_state\": " << config.x87_state.every_n_captures
+             << ", \"render_surface\": " << config.render_surface.every_n_captures << "},\n"
+		     << "  \"events\": {\"enabled\": " << (config.events_enabled ? "true" : "false")
+		     << ", \"video_mode_change\": " << (config.event_video_mode_change ? "true" : "false")
+		     << ", \"process_exit\": " << (config.event_process_exit ? "true" : "false") << "},\n";
+	}
+    if (config.reference_enabled) {
+        json << "  \"reference\":{\"normal_boundaries\":" << instruction_boundary_count
+             << ",\"buffered_events\":" << reference_events.size() << ",\"dropped_events\":" << dropped_events
+             << ",\"cpu_settings_override\":" << (cpu_settings_override ? "true" : "false")
+             << ",\"cpu_trace_incomplete\":" << (cpu_trace_incomplete ? "true" : "false")
+             << ",\"expected_cycles\":" << config.expected_cycles
+             << ",\"start_at_first_address\":" << (config.start_at_first_address ? "true" : "false")
+             << ",\"trace_instructions\":" << (config.trace_instructions ? "true" : "false") << "},\n";
+    }
+	json << "  \"configuration\": " << dosbox_agent::AGENT_SerializeJson(config.effective) << "\n}\n";
+	return json.str();
+}
+
+bool IsShellProcess()
+{
+	if (dos_kernel_disabled || !dos.psp()) return true;
+	const uint16_t psp = dos.psp();
+	const uint16_t shell = DOS_ShellGetPSP();
+	if (psp == shell) return true;
+	if (RunningProgram == "COMMAND" || RunningProgram == "4DOS" || RunningProgram == "DOSBOX-X" || RunningProgram == "LOADLIN") return true;
+	return false;
+}
+
+bool CreateSessionDirectory(std::string* error)
+{
+	if (!MakeDirectories(config.output_directory)) {
+		if (error) *error = "Unable to create output directory: " + config.output_directory;
+		return false;
+	}
+	const std::string stamp = HostTime();
+	for (unsigned int suffix = 0; suffix < 1000; ++suffix) {
+		std::ostringstream name;
+		name << stamp;
+		if (suffix) name << "_" << std::setw(3) << std::setfill('0') << suffix;
+		const std::string candidate = Join(config.output_directory, name.str());
+		if (IsDirectory(candidate)) continue;
+		if (MakeDirectory(candidate)) {
+			session_path = candidate;
+			return true;
+		}
+	}
+	if (error) *error = "Unable to create a unique session directory under " + config.output_directory;
+	return false;
+}
+
+void Attach(const char* executable, const uint16_t psp)
+{
+	state = State::Running;
+	tracked_psp = psp;
+	process_name = executable ? executable : "unknown";
+	attached_video_mode = vga.mode;
+	video_mode_initialized = true;
+	execution_address_latched = false;
+	process_start_us = GuestTimeUs();
+	const uint64_t first_deadline_delta = config.initial_delay_us ? config.initial_delay_us : config.interval_us;
+	next_periodic_us = process_start_us > (std::numeric_limits<uint64_t>::max)() - first_deadline_delta
+			? (std::numeric_limits<uint64_t>::max)()
+			: process_start_us + first_deadline_delta;
+	LOG_MSG("AUTOCAP: Attached to %s PSP=%04X", process_name.c_str(), tracked_psp);
+	std::string error;
+	if (!WriteAtomic(Join(session_path, "session.json"), SessionManifest("running"), &error))
+		LOG_MSG("AUTOCAP: %s", error.c_str());
+	AUTOCAP_RefreshMenuItems();
+	if (config.initial_delay_us == 0) {
+		periodic_pending = true;
+		pending_scheduled_us = process_start_us;
+	}
+}
