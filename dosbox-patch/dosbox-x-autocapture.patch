diff --git a/tests/agent/verify_automatic_capture.ps1 b/tests/agent/verify_automatic_capture.ps1
new file mode 100644
index 000000000..b3a60d5ca
--- /dev/null
+++ b/tests/agent/verify_automatic_capture.ps1
@@ -0,0 +1,137 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)]
+    [string]$SessionDirectory,
+    [string]$Version1SessionDirectory = ''
+)
+
+$ErrorActionPreference = 'Stop'
+
+function Assert-Condition {
+    param(
+        [bool]$Condition,
+        [string]$Message
+    )
+
+    if (!$Condition) {
+        throw $Message
+    }
+}
+
+function Get-PngGeometry {
+    param([string]$Path)
+
+    $bytes = [System.IO.File]::ReadAllBytes($Path)
+    Assert-Condition ($bytes.Length -ge 24) "PNG is shorter than its IHDR header: $Path"
+    $signature = [byte[]](0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a)
+    for ($index = 0; $index -lt $signature.Length; ++$index) {
+        Assert-Condition ($bytes[$index] -eq $signature[$index]) "Invalid PNG signature: $Path"
+    }
+    Assert-Condition ([System.Text.Encoding]::ASCII.GetString($bytes, 12, 4) -eq 'IHDR') "PNG has no IHDR chunk: $Path"
+    return [pscustomobject]@{
+        Width = ([uint32]$bytes[16] -shl 24) -bor ([uint32]$bytes[17] -shl 16) -bor ([uint32]$bytes[18] -shl 8) -bor [uint32]$bytes[19]
+        Height = ([uint32]$bytes[20] -shl 24) -bor ([uint32]$bytes[21] -shl 16) -bor ([uint32]$bytes[22] -shl 8) -bor [uint32]$bytes[23]
+    }
+}
+
+function Test-AssetSizes {
+    param(
+        [object]$Capture,
+        [string]$CaptureDirectory,
+        [bool]$ExpectV2
+    )
+
+    foreach ($property in $Capture.assets.PSObject.Properties) {
+        $asset = $property.Value
+        if ($asset.status -eq 'complete' -or (!$ExpectV2 -and $asset.status -eq 'ok')) {
+            Assert-Condition (![string]::IsNullOrWhiteSpace($asset.file)) "Complete asset $($property.Name) has no file"
+            $path = Join-Path $CaptureDirectory $asset.file
+            Assert-Condition (Test-Path -LiteralPath $path -PathType Leaf) "Complete asset $($property.Name) is missing: $path"
+            $actualSize = [uint64]([System.IO.FileInfo]$path).Length
+            Assert-Condition ($actualSize -eq [uint64]$asset.size) "Asset $($property.Name) reports size $($asset.size), but file size is $actualSize"
+        }
+        if ($ExpectV2 -and $asset.status -eq 'skipped') {
+            Assert-Condition ($asset.reason -eq 'cadence') "Skipped asset $($property.Name) has an unexpected reason"
+            Assert-Condition ([uint64]$asset.every_n_captures -gt 1) "Skipped asset $($property.Name) has no configured cadence"
+            Assert-Condition ([uint64]$asset.size -eq 0) "Skipped asset $($property.Name) has a non-zero size"
+            Assert-Condition ([string]::IsNullOrEmpty($asset.file)) "Skipped asset $($property.Name) unexpectedly has a file"
+        }
+    }
+}
+
+function Test-V2Session {
+    param([string]$Path)
+
+    $session = Get-Content -LiteralPath (Join-Path $Path 'session.json') -Raw | ConvertFrom-Json
+    Assert-Condition ($session.format_version -eq 2) 'Expected a version-2 capture session'
+    $captures = @(Get-ChildItem -LiteralPath $Path -Directory -Filter 'capture_*' | Sort-Object Name)
+    Assert-Condition ($captures.Count -gt 0) 'No finalized captures were found'
+
+    foreach ($directory in $captures) {
+        $capture = Get-Content -LiteralPath (Join-Path $directory.FullName 'capture.json') -Raw | ConvertFrom-Json
+        Assert-Condition ($capture.format_version -eq 2) "$($directory.Name) is not version 2"
+        Test-AssetSizes $capture $directory.FullName $true
+
+        $screenshot = $capture.assets.screenshot
+        if ($null -ne $screenshot -and $screenshot.status -eq 'complete') {
+            $geometry = $screenshot.metadata.screenshot_geometry
+            Assert-Condition ($null -ne $geometry) "$($directory.Name) has no screenshot geometry"
+            $png = Get-PngGeometry (Join-Path $directory.FullName $screenshot.file)
+            Assert-Condition ($png.Width -eq [uint32]$geometry.output_width) "$($directory.Name) screenshot width disagrees with PNG"
+            Assert-Condition ($png.Height -eq [uint32]$geometry.output_height) "$($directory.Name) screenshot height disagrees with PNG"
+            $scaleWidth = if ($geometry.double_width) { 2 } else { 1 }
+            $scaleHeight = if ($geometry.double_height) { 2 } else { 1 }
+            Assert-Condition ($png.Width -eq ([uint32]$geometry.source_width * $scaleWidth)) "$($directory.Name) screenshot horizontal scaling is inconsistent"
+            Assert-Condition ($png.Height -eq ([uint32]$geometry.source_height * $scaleHeight)) "$($directory.Name) screenshot vertical scaling is inconsistent"
+        }
+
+        $machine = $capture.assets.machine_state
+        if ($null -ne $machine -and $machine.status -eq 'complete') {
+            $state = Get-Content -LiteralPath (Join-Path $directory.FullName $machine.file) -Raw | ConvertFrom-Json
+            foreach ($name in @('cs', 'ds', 'es', 'ss', 'fs', 'gs')) {
+                $segment = $state.segments.$name
+                Assert-Condition ($null -ne $segment) "$($directory.Name) is missing $name machine state"
+                Assert-Condition (![string]::IsNullOrWhiteSpace($segment.selector)) "$($directory.Name) has no $name selector"
+                Assert-Condition (![string]::IsNullOrWhiteSpace($segment.base)) "$($directory.Name) has no $name base"
+            }
+            if ($null -ne $capture.assets.registers -and $capture.assets.registers.status -eq 'complete') {
+                $registers = Get-Content -LiteralPath (Join-Path $directory.FullName $capture.assets.registers.file) -Raw | ConvertFrom-Json
+                Assert-Condition ($state.segments.cs.selector -eq $registers.cs) "$($directory.Name) machine-state capture changed CS"
+            }
+        }
+
+        $vga = $capture.assets.vga_state
+        if ($null -ne $vga -and $vga.status -eq 'complete') {
+            $state = Get-Content -LiteralPath (Join-Path $directory.FullName $vga.file) -Raw | ConvertFrom-Json
+            if ($null -ne $state.dac) {
+                foreach ($field in @('read_index', 'write_index', 'component_state', 'pel_index', 'pel_mask')) {
+                    Assert-Condition ($null -ne $state.dac.$field) "$($directory.Name) is missing DAC $field"
+                    Assert-Condition ([uint32]$state.dac.$field -le 255) "$($directory.Name) has an invalid DAC $field"
+                }
+            }
+        }
+    }
+}
+
+function Test-Version1Session {
+    param([string]$Path)
+
+    $session = Get-Content -LiteralPath (Join-Path $Path 'session.json') -Raw | ConvertFrom-Json
+    Assert-Condition ($session.format_version -eq 1) 'Expected a version-1 capture session'
+    Assert-Condition ($session.configuration.version -eq 1) 'Version-1 session did not retain its configuration version'
+    Assert-Condition (![string]::IsNullOrWhiteSpace($session.configuration.output.directory)) 'Version-1 configuration output.directory is missing'
+    foreach ($directory in @(Get-ChildItem -LiteralPath $Path -Directory -Filter 'capture_*')) {
+        $capture = Get-Content -LiteralPath (Join-Path $directory.FullName 'capture.json') -Raw | ConvertFrom-Json
+        Assert-Condition ($capture.format_version -eq 1) "$($directory.Name) is not version 1"
+        foreach ($property in $capture.assets.PSObject.Properties) {
+            Assert-Condition ($property.Value.status -ne 'complete') "Version-1 asset $($property.Name) changed its status spelling"
+        }
+        Test-AssetSizes $capture $directory.FullName $false
+    }
+}
+
+Test-V2Session (Resolve-Path -LiteralPath $SessionDirectory).Path
+if (![string]::IsNullOrWhiteSpace($Version1SessionDirectory)) {
+    Test-Version1Session (Resolve-Path -LiteralPath $Version1SessionDirectory).Path
+}
+Write-Output 'Automatic-capture format validation passed.'
